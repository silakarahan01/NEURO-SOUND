# NEURO SOUND — Ortam Değişkenleri Şablonu
# Kullanım: `cp .env.example .env` ardından değerleri kendi ortamınıza göre doldurun.
# .env dosyasını ASLA commit etmeyin (.gitignore zaten kapsıyor).

# ─── Güvenlik ───────────────────────────────────────────────────
# Production için yeni bir anahtar üretin:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-50-char-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Production'da kendi domain'lerinizi virgülle ekleyin: ALLOWED_HOSTS=neurosound.com,www.neurosound.com

# ─── CSRF Güvenilir Kaynaklar ───────────────────────────────────
# HTTPS ile servis edilen production domain'leri (virgülle ayrılır)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ─── Veritabanı ─────────────────────────────────────────────────
DB_NAME=neuro_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# ─── E-posta ────────────────────────────────────────────────────
# Geliştirme: console backend (e-postalar terminale yazdırılır)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Production örneği (Gmail SMTP):
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=NEURO SOUND <info@neurosound.com>

# ─── Uygulama ───────────────────────────────────────────────────
ADMIN_CONTACT_EMAIL=info@neurosound.com

# ─── Oturum (Session) Ayarları ──────────────────────────────────
# Saniye cinsinden — 1209600 = 14 gün
SESSION_COOKIE_AGE=1209600
SESSION_EXPIRE_AT_BROWSER_CLOSE=False
